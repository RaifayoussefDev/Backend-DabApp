##############################################################################
# Server .env  —  copy to `.env` next to docker-compose.yml on each server.
# Values differ per environment (prod / dev / test).
##############################################################################

# ---- Core -----------------------------------------------------------------
APP_NAME=DabApp
APP_ENV=production                 # dev / test on the other servers
APP_DEBUG=false                    # true only on dev/test
APP_KEY=base64:CHANGE_ME           # php artisan key:generate --show  (KEEP the current prod key)
APP_URL=https://be.dabapp.co      # https://be-dev.dabapp.co / https://be-test.dabapp.co
FRONTEND_URL=https://dabapp.co
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ---- Compose knobs (read by docker-compose.yml, not Laravel) -------------
IMAGE=ghcr.io/fadelbg/dabapp-backend
IMAGE_TAG=prod                     # CI overrides this with <branch>-<sha>
HTTP_PORT=8000                     # reverse-proxied by the host nginx / traefik

# ---- Database (separate DB server) --------------------------------------
DB_CONNECTION=mysql
DB_HOST=10.0.0.10                  # private IP / hostname of the DB server
DB_PORT=3306
DB_DATABASE=dabapp_prod            # dabapp_dev / dabapp_test
DB_USERNAME=dabapp_prod
DB_PASSWORD=CHANGE_ME

# ---- Cache / queue / session (Redis container on the same server) -------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ---- Broadcasting (Reverb, proxied at /app and /apps) -------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=850128
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=be.dabapp.co          # public host clients connect to (wss)
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ---- Mail (Mailgun EU) -------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.eu.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=no-reply@dabapp.co
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@dabapp.co
MAIL_FROM_NAME=DabApp

# ---- Auth ------------------------------------------------------------
JWT_SECRET=CHANGE_ME               # KEEP the current prod value

# ---- Payments (PayTabs) --------------------------------------------
PAYTABS_ENVIRONMENT=live           # test on dev/test servers
PAYTABS_LIVE_PROFILE_ID=145577
PAYTABS_LIVE_SERVER_KEY=CHANGE_ME
PAYTABS_LIVE_CLIENT_KEY=CHANGE_ME
PAYTABS_LIVE_CURRENCY=AED
PAYTABS_LIVE_REGION=ARE
PAYTABS_TEST_PROFILE_ID=144127
PAYTABS_TEST_SERVER_KEY=CHANGE_ME
PAYTABS_TEST_CLIENT_KEY=CHANGE_ME
PAYTABS_TEST_CURRENCY=AED
PAYTABS_TEST_REGION=ARE
SKIP_PAYTABS=false

# ---- OTP / WhatsApp (AISensy) -------------------------------------
OTP_WHATSAPP_ENABLED=true
OTP_EMAIL_ENABLED=true
AISENSY_API_KEY=CHANGE_ME
AISENSY_CAMPAIGN_NAME=DabApp
AISENSY_USERNAME=Fadel Brothers Group L.L.C

# ---- Firebase (push) — file mounted at app/firebase_credentials.json --
FIREBASE_PROJECT_ID=dabapp-3d853
FIREBASE_CREDENTIALS=../../app/firebase_credentials.json

# ---- Storage ---------------------------------------------------------
FILESYSTEM_DISK=local              # switch to s3 + AWS_* if object storage is chosen
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ---- Browsershot / puppeteer (already baked into the image) ---------
NODE_BINARY_PATH=/usr/bin/node
NPM_BINARY_PATH=/usr/bin/npm
CHROME_PATH=/usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ---- Swagger docs --------------------------------------------------
SWAGGER_USER=admin
SWAGGER_PASSWORD=CHANGE_ME

# ---- Logs --------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning                  # debug on dev/test
