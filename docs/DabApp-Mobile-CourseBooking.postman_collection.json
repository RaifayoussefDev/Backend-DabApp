  "item": [
    {
      "name": "Phase 1 — Find a Course (public, no auth)",
      "description": "No auth required. Confirms browse/detail/availability and captures total_price_aed + course_total_sessions for later phases.",
      "item": [
        {
          "name": "1-1 · GET Browse All Courses (with all filters)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Courses listed', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/courses?sort_by=newest&per_page=9&level_id=3&city_id=1&location_id=1&can_travel=true&min_price=100&max_price=5000&search=circuit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "courses"
              ],
              "query": [
                {
                  "key": "sort_by",
                  "value": "newest",
                  "description": "Enum: newest (default) | price_asc | price_desc"
                },
                {
                  "key": "per_page",
                  "value": "9",
                  "description": "Pagination page size, default 15"
                },
                {
                  "key": "level_id",
                  "value": "3",
                  "description": "Filter by trainer level. Disabled below — enable to test.",
                  "disabled": true
                },
                {
                  "key": "city_id",
                  "value": "1",
                  "description": "Filter by course location's city. Disabled below — enable to test.",
                  "disabled": true
                },
                {
                  "key": "location_id",
                  "value": "1",
                  "description": "Filter by exact location. Disabled below — enable to test.",
                  "disabled": true
                },
                {
                  "key": "can_travel",
                  "value": "true",
                  "description": "true = only courses where the trainer travels to the client. Disabled below — enable to test.",
                  "disabled": true
                },
                {
                  "key": "min_price",
                  "value": "100",
                  "description": "Minimum original_price. Disabled below — enable to test.",
                  "disabled": true
                },
                {
                  "key": "max_price",
                  "value": "5000",
                  "description": "Maximum original_price. Disabled below — enable to test.",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "circuit",
                  "description": "Case-insensitive match against title/title_ar. Disabled below — enable to test.",
                  "disabled": true
                }
              ]
            },
            "description": "Public course catalog. Every filter param is optional and combinable. Note: this listing endpoint returns prices in the course's display currency, not AED — only Course Detail (1-3) and Book Course (3-1) return `total_price_aed`."
          }
        },
        {
          "name": "1-2 · GET Trainer's Published Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trainers/{{trainer_id}}/courses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trainers",
                "{{trainer_id}}",
                "courses"
              ]
            }
          }
        },
        {
          "name": "1-3 · GET Course Detail (captures total_price_aed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "var data = json.data || {};",
                  "if (data.total_sessions) { pm.collectionVariables.set('course_total_sessions', String(data.total_sessions)); }",
                  "if (data.total_price_aed) {",
                  "  pm.collectionVariables.set('course_price_aed', String(data.total_price_aed));",
                  "  console.log('total_price_aed = ' + data.total_price_aed + ' (total_price=' + data.total_price + ' in display currency)');",
                  "}",
                  "pm.test('Course detail retrieved', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response includes total_price_aed', function () { pm.expect(data.total_price_aed).to.not.be.undefined; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trainers/{{trainer_id}}/courses/{{course_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trainers",
                "{{trainer_id}}",
                "courses",
                "{{course_id}}"
              ]
            },
            "description": "Full public detail: description, trainer summary, pricing (`total_price` in display currency + `total_price_aed` for the PayTabs SDK), image, sessions breakdown, equipment, training bikes."
          }
        },
        {
          "name": "1-4 · GET Course Session Breakdown (descriptive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trainers/{{trainer_id}}/courses/{{course_id}}/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trainers",
                "{{trainer_id}}",
                "courses",
                "{{course_id}}",
                "sessions"
              ]
            }
          }
        },
        {
          "name": "1-5 · GET Course Availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "var slots = (json.data && json.data.available_slots) || [];",
                  "console.log('Available dates in range: ' + slots.map(function(s){return s.date;}).join(', '));",
                  "pm.test('Availability retrieved', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trainers/{{trainer_id}}/courses/{{course_id}}/availability?from_date={{avail_from}}&to_date={{avail_to}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trainers",
                "{{trainer_id}}",
                "courses",
                "{{course_id}}",
                "availability"
              ],
              "query": [
                {
                  "key": "from_date",
                  "value": "{{avail_from}}"
                },
                {
                  "key": "to_date",
                  "value": "{{avail_to}}"
                }
              ]
            },
            "description": "Slots are sized to hours_per_session and already exclude the trainer's existing bookings. If session_1_date/session_2_date have gone stale, pick two fresh distinct dates from here — use the FIRST part of a `time_slots` entry (e.g. \"09:00\" from \"09:00-11:00\") as the start_time in the booking body, never the full range."
          }
        }
      ]
    },
    {
      "name": "Phase 2 — Login (Trainee, Trainer)",
      "item": [
        {
          "name": "2-1 · POST Trainee Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.requiresOTP) { console.warn('This account requires OTP verification — complete it via /api/verify-otp, then paste the resulting token into {{trainee_token}} manually.'); }",
                  "else if (json.token) { pm.collectionVariables.set('trainee_token', json.token); console.log('trainee_token saved'); }",
                  "pm.test('Login request succeeded', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{trainee_email}}\",\n  \"password\": \"{{trainee_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          }
        },
        {
          "name": "2-2 · POST Trainer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.requiresOTP) { console.warn('This account requires OTP verification — complete it via /api/verify-otp, then paste the resulting token into {{trainer_token}} manually.'); }",
                  "else if (json.token) { pm.collectionVariables.set('trainer_token', json.token); console.log('trainer_token saved'); }",
                  "pm.test('Login request succeeded', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{trainer_email}}\",\n  \"password\": \"{{trainer_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Must be the user account linked to the Trainer record for trainer_id, otherwise Phase 6 will 403 with 'No trainer profile found'."
          }
        }
      ]
    },
    {
      "name": "Phase 3 — Book the Course",
      "item": [
        {
          "name": "3-1 · POST Book Course (all sessions, one payment — captures total_price_aed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "var data = json.data || {};",
                  "if (data.course_booking_id) { pm.collectionVariables.set('course_booking_id', String(data.course_booking_id)); console.log('course_booking_id = ' + data.course_booking_id); }",
                  "if (data.total_price_aed) {",
                  "  pm.collectionVariables.set('booking_price_aed', String(data.total_price_aed));",
                  "  console.log('Send this amount to the PayTabs SDK: ' + data.total_price_aed + ' AED');",
                  "}",
                  "pm.test('Course booked (201)', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response includes total_price_aed', function () { pm.expect(data.total_price_aed).to.not.be.undefined; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{trainee_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessions\": [\n    { \"session_number\": 1, \"booking_date\": \"{{session_1_date}}\", \"start_time\": \"{{session_1_time}}\" },\n    { \"session_number\": 2, \"booking_date\": \"{{session_2_date}}\", \"start_time\": \"{{session_2_time}}\" }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/trainers/{{trainer_id}}/courses/{{course_id}}/book",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trainers",
                "{{trainer_id}}",
                "courses",
                "{{course_id}}",
                "book"
              ]
            },
            "description": "`sessions` must have exactly `course_total_sessions` entries, `session_number` values exactly 1..N each once, and every `booking_date` distinct. `start_time` is HH:MM only — never a full \"HH:MM-HH:MM\" slot range. The response's `payment_url` is for the web redirect flow — ignore it on mobile and use `total_price_aed` with the native SDK instead."
          }
        },
        {
          "name": "3-2 · GET My Course Bookings (captures OTPs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "var data = json.data || {};",
                  "var all = (data.in_progress || []).concat(data.completed || []);",
                  "var bookingId = pm.collectionVariables.get('course_booking_id');",
                  "var booking = all.find(function (b) { return String(b.id) === String(bookingId); });",
                  "if (booking && booking.sessions) {",
                  "  var sessions = booking.sessions.slice().sort(function (a, b) { return a.session_number - b.session_number; });",
                  "  sessions.forEach(function (s, idx) {",
                  "    var n = idx + 1;",
                  "    pm.collectionVariables.set('session_' + n + '_id', String(s.id));",
                  "    pm.collectionVariables.set('session_' + n + '_start_otp', s.start_otp || '');",
                  "    pm.collectionVariables.set('session_' + n + '_completion_otp', s.completion_otp || '');",
                  "  });",
                  "  console.log('Captured ' + sessions.length + ' session(s) with their OTPs.');",
                  "} else {",
                  "  console.warn('Booking ' + bookingId + ' not found in in_progress/completed — did step 3-1 succeed?');",
                  "}",
                  "pm.test('My course bookings retrieved', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{trainee_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/trainer/course-bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trainer",
                "course-bookings"
              ]
            },
            "description": "Grouped into { in_progress, completed }. Only the trainee's own view ever includes start_otp/completion_otp per session — show these on the trainee's \"My Courses\" screen for them to hand to the trainer in person."
          }
        }
      ]
    },
    {
      "name": "Phase 4 — Pay via SDK, then Verify",
      "description": "This is the mobile-only path. After the native PayTabs SDK finishes, call verify-payment yourself with the tran_ref it returned — never call /payments/callback or /payments/return, those are web-only.",
      "item": [
        {
          "name": "4-1 · [SDK step — not an API call] Open PayTabs native SDK with total_price_aed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trainers/{{trainer_id}}/courses/{{course_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trainers",
                "{{trainer_id}}",
                "courses",
                "{{course_id}}"
              ]
            },
            "description": "Placeholder request — no real API call happens here. In the app: initialize the PayTabs SDK with amount = {{booking_price_aed}} AED and your PayTabs client key. On success, the SDK gives you a `tran_ref` — paste it into the `sdk_tran_ref` collection variable, then run 4-2."
          }
        },
        {
          "name": "4-2 · POST Verify Payment (skip_verification — exercises the sdk_trust fallback)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Payment verified', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.success).to.eql(true);",
                  "});",
                  "pm.test('Booking confirmed + paid', function () {",
                  "  pm.expect(json.data.status).to.eql('confirmed');",
                  "  pm.expect(json.data.payment_status).to.eql('paid');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{trainee_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_booking_id\": {{course_booking_id}},\n  \"tran_ref\": \"{{sdk_tran_ref}}\",\n  \"skip_verification\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/trainer/course-bookings/verify-payment",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "trainer",
                "course-bookings",
                "verify-payment"
              ]
            },
            "description": "`skip_verification: true` trusts the SDK's own success report instead of calling PayTabs — use this only if the query API is briefly unreachable. Response's `data.verification_method` will be `sdk_trust`. This confirms the booking, creates the commission split + payout record, and notifies the trainer."
          }
        },
        {
          "name": "4-3 (alt) · POST Verify Payment — real PayTabs check (skip_verification: false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verification attempted', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
