            "url": { "raw": "{{base_url}}/api/trainers/{{trainer_id}}/courses/{{course_id}}/book", "host": ["{{base_url}}"], "path": ["api","trainers","{{trainer_id}}","courses","{{course_id}}","book"] },
            "description": "Sends only 1 session for a course that requires course_total_sessions (2 by default here)."
          }
        },
        {
          "name": "8-2 · POST Book Course — duplicate dates (expect 422)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Rejected with 422', function () { pm.response.to.have.status(422); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{trainee_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"sessions\": [\n    { \"session_number\": 1, \"booking_date\": \"{{session_1_date}}\", \"start_time\": \"09:00\" },\n    { \"session_number\": 2, \"booking_date\": \"{{session_1_date}}\", \"start_time\": \"11:00\" }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/trainers/{{trainer_id}}/courses/{{course_id}}/book", "host": ["{{base_url}}"], "path": ["api","trainers","{{trainer_id}}","courses","{{course_id}}","book"] }
          }
        },
        {
          "name": "8-3 · POST Start Session — wrong OTP (expect 422)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Rejected with 422 Invalid code', function () { pm.response.to.have.status(422); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{trainer_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"otp\": \"000000\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/trainer/course-sessions/{{session_1_id}}/start", "host": ["{{base_url}}"], "path": ["api","trainer","course-sessions","{{session_1_id}}","start"] },
            "description": "Only meaningful BEFORE Phase 5-2 has run (session must still be `scheduled`). Run this first if you want to see the failure case, then run Phase 5-2 with the real OTP."
          }
        },
        {
          "name": "8-4 · GET My Course Bookings — unauthenticated (expect 401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Rejected with 401', function () { pm.response.to.have.status(401); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/trainer/course-bookings", "host": ["{{base_url}}"], "path": ["api","trainer","course-bookings"] }
          }
        }
      ]
    }
  ]
